{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensourcemed.info/schemas/evidence-graph/entity.schema.json",
  "title": "OSMF Evidence Graph Entity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "label", "status", "updated_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^osmf:[a-z0-9-]+:[a-z0-9-]+$",
      "description": "Stable canonical ID, e.g. osmf:condition:pacvs"
    },
    "type": {
      "type": "string",
      "enum": [
        "condition",
        "phenotype",
        "biomarker",
        "agent",
        "trial",
        "paper",
        "cohort",
        "specimen-type",
        "diagnostic-criterion",
        "vaccine-lot"
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true,
      "default": []
    },
    "summary": {
      "type": "string",
      "description": "Short neutral description; not clinical advice"
    },
    "external_ids": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["system", "value"],
        "properties": {
          "system": {
            "type": "string",
            "enum": [
              "mondo",
              "mesh",
              "hpo",
              "umls",
              "chembl",
              "drugbank",
              "pubmed",
              "doi",
              "nct",
              "open_targets",
              "other"
            ]
          },
          "value": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "urls": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rel", "href"],
        "properties": {
          "rel": {
            "type": "string",
            "enum": [
              "canonical",
              "tracker",
              "spikeprotein",
              "navigator",
              "summit",
              "other"
            ]
          },
          "href": { "type": "string", "format": "uri" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "deprecated"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

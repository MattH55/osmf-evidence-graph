{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensourcemed.info/schemas/evidence-graph/claim.schema.json",
  "title": "OSMF Evidence Graph Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject_id",
    "predicate",
    "evidence_tier",
    "sources",
    "status",
    "reviewed_at",
    "license"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^osmf:claim:[a-z0-9-]+$"
    },
    "subject_id": {
      "type": "string",
      "pattern": "^osmf:[a-z0-9-]+:[a-z0-9-]+$"
    },
    "predicate": {
      "type": "string",
      "enum": [
        "biomarker_of",
        "phenotype_of",
        "treats_candidate_for",
        "studied_in",
        "supported_by",
        "conflicts_with",
        "supports_criterion",
        "measured_in",
        "associated_with_exposure",
        "related_to",
        "supersedes"
      ]
    },
    "object_id": {
      "type": "string",
      "pattern": "^osmf:[a-z0-9-]+:[a-z0-9-]+$",
      "description": "Use object_id XOR object_literal"
    },
    "object_literal": {
      "type": "string",
      "minLength": 1,
      "description": "Use when the object is not (yet) a first-class entity"
    },
    "evidence_tier": {
      "type": "string",
      "enum": ["A", "B", "C", "D"],
      "description": "A=strong clinical/consensus; B=solid clinical/synthesis; C=mechanistic/preclinical/case; D=contested/insufficient"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "value"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["doi", "pmid", "nct", "url", "osmf_page"]
          },
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string" }
        }
      }
    },
    "limitations": {
      "type": "string",
      "description": "Required for tiers C and D; strongly recommended for B"
    },
    "confidence_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published", "superseded"]
    },
    "supersedes_id": {
      "type": "string",
      "pattern": "^osmf:claim:[a-z0-9-]+$"
    },
    "reviewed_by": {
      "type": "string",
      "description": "Curator name or ORCID; optional on draft"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "license": {
      "type": "string",
      "minLength": 1
    }
  },
  "oneOf": [
    {
      "required": ["object_id"],
      "not": { "required": ["object_literal"] }
    },
    {
      "required": ["object_literal"],
      "not": { "required": ["object_id"] }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": { "evidence_tier": { "const": "C" } },
        "required": ["evidence_tier"]
      },
      "then": {
        "required": ["limitations"],
        "properties": {
          "limitations": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "evidence_tier": { "const": "D" } },
        "required": ["evidence_tier"]
      },
      "then": {
        "required": ["limitations"],
        "properties": {
          "limitations": { "type": "string", "minLength": 1 }
        }
      }
    }
  ]
}
